# Copie para .env.local e ajuste
#
# --- Antes da aprovação do cliente (revisão local / zip / drive) ---
# Não defina NEXT_PUBLIC_SITE_URL nem NEXT_PUBLIC_SITE_PUBLISHED.
# O site usa localhost (ou URL da Vercel em preview), robots bloqueia "/" e páginas ficam noindex.
#
# --- Depois da aprovação e domínio definido ---
# NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
# NEXT_PUBLIC_SITE_PUBLISHED=true
#
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_PUBLISHED=false
# Logo: arquivo em /public (ex.: /images/logo.png) ou URL https completa
NEXT_PUBLIC_LOGO_SRC=/images/logo.png
NEXT_PUBLIC_CONTACT_EMAIL=contato@construirempreendimentos.com.br
# DDI + DDD + número (somente dígitos) para link wa.me
NEXT_PUBLIC_WHATSAPP_DIGITS=5511999999999
